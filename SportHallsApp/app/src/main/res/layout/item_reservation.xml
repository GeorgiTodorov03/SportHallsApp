<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    app:cardCornerRadius="14dp"
    app:cardBackgroundColor="#0F1A24"
    app:strokeWidth="1dp"
    app:strokeColor="#1E293B">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <ImageView
            android:id="@+id/ivResIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_myplaces"
            app:tint="#38BDF8"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="14dp"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_toEndOf="@id/ivResIcon"
            android:layout_toStartOf="@id/tvResStatus"
            android:layout_centerVertical="true">

            <TextView
                android:id="@+id/tvResHallName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Арена София"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvResDateTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="25.05.2026 • 18:00 ч."
                android:textColor="#94A3B8"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvResStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Одобрена"
            android:textColor="#22C55E"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@android:color/transparent" />

    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>